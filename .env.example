# --- Supabase --------------------------------------------------------------
# Project Settings > API. Either key format works, no code changes needed:
# the legacy JWT-shaped anon/service_role keys, or Supabase's newer
# sb_publishable_.../sb_secret_... keys — paste whichever your project shows.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Secret/service role key — server-only, NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Groq --------------------------------------------------------------
# https://console.groq.com/keys — server-only, NEVER expose to the client.
GROQ_API_KEY=gsk_...

# --- Cloudflare Turnstile ---------------------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# --- App -----------------------------------------------------------------
# Number of free AI questions per day for authenticated free-plan members
# (read by both server and client — see src/lib/quotaConfig.ts). Guests (no
# account) get a smaller, client-side-only allowance (GUEST_DAILY_LIMIT,
# hardcoded in quotaConfig.ts). Pro accounts are unlimited.
NEXT_PUBLIC_DAILY_FREE_QUESTIONS=15

# --- Dev bypass ------------------------------------------------------------
# Local dev only: skips all Supabase auth/DB/quota calls so the chat/AI flow
# works even if Supabase is unreachable. NEVER set this in production.
NEXT_PUBLIC_DISABLE_AUTH=false

# --- Resend (transactional e-mail) -----------------------------------------
# https://resend.com/api-keys — server-only, NEVER expose to the client.
RESEND_API_KEY=re_...
# Sender used for every outbound e-mail (support replies, Pro confirmation,
# welcome — see src/lib/email.ts). Left empty, falls back to Resend's shared
# sandbox sender (only deliverable to the Resend account's own address).
# Once a domain is verified at https://resend.com/domains, set this to
# something like "Asexcel <contact@asexcel.com>".
EMAIL_FROM=

# --- Site URL ----------------------------------------------------------
# Absolute origin used to resolve OpenGraph/share images to full URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Tebex (Pro plan billing) -----------------------------------------------
# Hosted checkout — no API key needed to create a checkout (see src/lib/tebex.ts).
NEXT_PUBLIC_TEBEX_STORE_URL=https://your-store.tebex.store
NEXT_PUBLIC_TEBEX_PACKAGE_MONTHLY=
NEXT_PUBLIC_TEBEX_PACKAGE_ANNUAL=
# https://creator.tebex.io/webhooks-settings — server-only, NEVER expose to the client.
TEBEX_WEBHOOK_SECRET=tebex_whsec_...

# --- Google AdSense (ad monetization for guest/free accounts) --------------
# https://www.google.com/adsense — Pro subscribers never see ads (see
# src/components/AdBanner.tsx). Left empty, ad slots render a "Emplacement
# publicitaire" placeholder instead of a real ad request.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-...
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_RESULT=
