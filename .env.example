# --- Supabase --------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Groq --------------------------------------------------------------
# https://console.groq.com/keys — server-only, NEVER expose to the client.
GROQ_API_KEY=gsk_...

# --- Cloudflare Turnstile ---------------------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# --- App -----------------------------------------------------------------
# Number of free AI questions per day for authenticated free-plan members
# (read by both server and client — see src/lib/quotaConfig.ts). Guests (no
# account) get a smaller, client-side-only allowance (GUEST_DAILY_LIMIT,
# hardcoded in quotaConfig.ts). Pro accounts are unlimited.
NEXT_PUBLIC_DAILY_FREE_QUESTIONS=15

# --- Dev bypass ------------------------------------------------------------
# Local dev only: skips all Supabase auth/DB/quota calls so the chat/AI flow
# works even if Supabase is unreachable. NEVER set this in production.
NEXT_PUBLIC_DISABLE_AUTH=false

# --- Resend (transactional e-mail) -----------------------------------------
# https://resend.com/api-keys — server-only, NEVER expose to the client.
RESEND_API_KEY=re_...

# --- Site URL ----------------------------------------------------------
# Absolute origin used to resolve OpenGraph/share images to full URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Lemon Squeezy (Pro plan billing) ---------------------------------------
# https://app.lemonsqueezy.com/settings/api — server-only, NEVER expose to the client.
LEMON_SQUEEZY_API_KEY=ls_...
# https://app.lemonsqueezy.com/settings/stores — the numeric store ID.
LEMON_SQUEEZY_STORE_ID=
# https://app.lemonsqueezy.com/settings/webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=ls_whsec_...
# Variant IDs from https://app.lemonsqueezy.com/products
LEMON_SQUEEZY_VARIANT_MONTHLY=
LEMON_SQUEEZY_VARIANT_ANNUAL=
LEMON_SQUEEZY_VARIANT_LIFETIME=
